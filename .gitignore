overton_scores*.csv
hivemind_gen*.jsonl
hivemind_diversity*.csv
grpo_prompts*.jsonl
grpo_lora/

# Local extracted ATP data (OpinionQA); large, load via OPINIONQA_DIR — don't commit
.localdata/