.pytest_cache
__pycache__/
**/__pycache__/
**/__init__.py
*.egg-info/

# LaTeX build artifacts
docs/**/*.aux
docs/**/*.log
docs/**/*.out

# Raw datasets are fetched, not committed (too large; see scripts/fetch/get_*.py)
data/grailqa/
*.pt
CLAUDE.md

# Generated eval outputs (produced on the cluster; pull via scp, don't commit —
# committing a stale copy collides with the cluster's resume files on git pull)
overton_responses*.jsonl
overton_scores*.csv
hivemind_gen*.jsonl
hivemind_diversity*.csv
grpo_prompts*.jsonl
grpo_lora/
contestedness*.json
contestedness_probe*.pt

# Local extracted ATP data (OpinionQA); large, load via OPINIONQA_DIR — don't commit
.localdata/
# Slide decks — regenerate from the script rather than tracking a binary
*.pptx
~$*

# Run artifacts written to the repo root by the eval jobs. Left in place rather
# than moved: ~17 scripts/jobs default to these bare filenames (RESP/SCORES/OUT).
overton_responses_*.jsonl
overton_scores_*.csv
hivemind_*.jsonl
hivemind_*.csv
grpo_prompts.jsonl

# Generated analysis plots — regenerate from the scores csv in seconds. Both
# machines write these, so committing them produces add/add binary conflicts on
# every pull (docs/bars_v11.png did exactly that). The CSVs are the record;
# the figures are a view of it. docs/figures/ is NOT covered: those are the
# hand-made paper figures.
docs/bars_*.png
docs/delta_ci_*.png
docs/feature_routing_*.png
docs/injection_usage*.png
docs/union_gain*.png
_routing_selftest.png

# Analysis outputs written next to the scores
docs/*_clusters.csv
docs/usage_positions*.csv
docs/injection_triage*.txt
docs/anchor_coverage.csv
